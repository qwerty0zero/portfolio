---
import "@styles/global.css";
import HeadSEO from "@components/common/HeadSEO.astro";
import SmoothScroll from "@components/common/SmoothScroll.astro";
import { defaultLang, type Lang } from "@i18n/languages";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "article";
	lang?: Lang;
}

const { title, description, ogImage, ogType, lang = defaultLang } = Astro.props;

const fontsPreloadMap: Record<Lang, string[]> = {
	en: [
		"/fonts/DelaGothicOne-Regular-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-latin.woff2",
	],
	pl: [
		"/fonts/DelaGothicOne-Regular-latin.woff2",
		"/fonts/DelaGothicOne-Regular-latinext.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-latinext.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-latinext.woff2",
	],
	ru: [
		"/fonts/DelaGothicOne-Regular-cyrillic.woff2",
		"/fonts/DelaGothicOne-Regular-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-latin.woff2",
	],
	uk: [
		"/fonts/DelaGothicOne-Regular-cyrillic.woff2",
		"/fonts/DelaGothicOne-Regular-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-latin.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-latin.woff2",
	],
};

const preloadedFonts = fontsPreloadMap[lang] ?? fontsPreloadMap[defaultLang];
---

<!doctype html>
<html lang={lang} dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<HeadSEO
			title={title}
			description={description}
			ogImage={ogImage}
			ogType={ogType}
			lang={lang}
		/>

		{/* Smart Language-Specific Font Preloading */}
		{preloadedFonts.map((fontHref) => (
			<link
				rel="preload"
				href={fontHref}
				as="font"
				type="font/woff2"
				crossorigin="anonymous"
			/>
		))}

		{/* Anti-FOUC Theme Initialization Script */}
		<script is:inline>
			(() => {
				const storedTheme =
					typeof localStorage !== "undefined"
						? localStorage.getItem("theme")
						: null;
				const userTheme =
					storedTheme ||
					(window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");
				if (userTheme === "dark") {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
			})();
		</script>
	</head>
	<body>
		<SmoothScroll />
		<div class="layout-wrapper">
			<slot />
		</div>
	</body>
</html>

<style>
	.layout-wrapper {
		width: calc(100% - 10vw);
		max-width: 1920px;
		margin-inline: auto;
		min-height: 100vh;
		min-height: 100dvh;
		border-left: 1px solid var(--border);
		border-right: 1px solid var(--border);
		position: relative;
	}

	@media (max-width: 768px) {
		.layout-wrapper {
			width: 100%;
			border-left: none;
			border-right: none;
		}
	}
</style>
