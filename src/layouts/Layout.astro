---
import "@styles/global.css";
import HeadSEO from "@components/common/HeadSEO.astro";
import Header from "@components/common/Header.astro";
import SmoothScroll from "@components/common/SmoothScroll.astro";
import { defaultLang, type Lang } from "@i18n/languages";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "article";
	lang?: Lang;
}

const { title, description, ogImage, ogType, lang = defaultLang } = Astro.props;

const fontsPreloadMap: Record<Lang, string[]> = {
	en: [
		"/fonts/DelaGothicOne-Regular.woff2",
		"/fonts/FiraSansExtraCondensed-Bold.woff2",
		"/fonts/FiraSansExtraCondensed-Regular.woff2",
	],
	pl: [
		"/fonts/DelaGothicOne-Regular.woff2",
		"/fonts/FiraSansExtraCondensed-Bold.woff2",
		"/fonts/FiraSansExtraCondensed-Regular.woff2",
	],
	ru: [
		"/fonts/DelaGothicOne-Regular-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-cyrillic.woff2",
	],
	uk: [
		"/fonts/DelaGothicOne-Regular-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Bold-cyrillic.woff2",
		"/fonts/FiraSansExtraCondensed-Regular-cyrillic.woff2",
	],
};

const preloadedFonts = fontsPreloadMap[lang] ?? fontsPreloadMap[defaultLang];
---

<!doctype html>
<html lang={lang} dir="ltr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{/* Smart Language-Specific Font Preloading */}
		{preloadedFonts.map((fontHref) => (
				<link
					rel="preload"
					href={fontHref}
					as="font"
					type="font/woff2"
					crossorigin="anonymous"
				/>
			))}

		<HeadSEO
			title={title}
			description={description}
			ogImage={ogImage}
			ogType={ogType}
			lang={lang}
		/>

		{/* Client Preferences & Anti-FOUC Theme Script */}
		<script is:inline>
		(() => {
			try {
				const savedLang = localStorage.getItem("preferred_lang");
				const path = window.location.pathname;
				if (
					savedLang &&
					(path === "/" || path === "") &&
					savedLang !== "ru" &&
					["en", "pl", "uk"].includes(savedLang)
				) {
					window.location.replace(`/${savedLang}`);
					return;
				}
			} catch (_) {}

			try {
				const storedTheme = localStorage.getItem("theme");
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				const userTheme =
					storedTheme === "dark" || storedTheme === "light"
						? storedTheme
						: prefersDark
							? "dark"
							: "light";

				if (userTheme === "dark") {
					document.documentElement.classList.add("dark");
					document.documentElement.classList.remove("light");
					document.documentElement.setAttribute("data-theme", "dark");
				} else {
					document.documentElement.classList.remove("dark");
					document.documentElement.classList.add("light");
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch (_) {}
		})();
		</script>
	</head>
	<body>
		<SmoothScroll />
		<Header lang={lang} />
		<div class="layout-wrapper fullscreen-min">
			<slot />
		</div>
	</body>
</html>

<style>
.layout-wrapper {
	width: calc(100% - 10vw);
	max-width: 1920px;
	margin-inline: auto;
	border-left: 1px solid var(--border);
	border-right: 1px solid var(--border);
	position: relative;
}

@media (max-width: 768px) {
	.layout-wrapper {
		width: 100%;
		border-left: none;
		border-right: none;
	}
}
</style>
