---
import { getCollection, getEntry } from "astro:content";
import About from "@components/sections/About.astro";
import Directions, {
	type DirectionItem,
} from "@components/sections/Directions.astro";
import Hero from "@components/sections/Hero.astro";
import Projects from "@components/sections/Projects.astro";
import { defaultLang, type Lang, languages } from "@i18n/languages";
import { useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	return Object.keys(languages).map((code) => {
		const lang = code as Lang;
		return {
			params: {
				lang: lang === defaultLang ? undefined : lang,
			},
		};
	});
}

const { lang } = Astro.params;
const currentLang: Lang =
	lang && lang in languages ? (lang as Lang) : defaultLang;

const homeEntry = await getEntry("pages", `${currentLang}/home`);
const pageTitle = homeEntry?.data.title || "Portfolio";
const t = useTranslations(currentLang);

const allProjects = await getCollection("projects");
const langProjects = allProjects
	.filter((project) => project.id.startsWith(`${currentLang}/`))
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => {
		const cleanId = project.id.replace(/\.md$/, "");
		const [, ...slugParts] = cleanId.split("/");
		const slug = slugParts.join("/");
		return {
			slug,
			title: project.data.title,
			category: project.data.category,
			description: project.data.description,
			stack: project.data.stack,
			year: project.data.year,
			githubUrl: project.data.githubUrl,
			liveUrl: project.data.liveUrl,
		};
	});

