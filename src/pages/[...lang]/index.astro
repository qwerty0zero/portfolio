---
import { getCollection, getEntry } from "astro:content";
import About from "@components/sections/About.astro";
import Hero from "@components/sections/Hero.astro";
import Projects from "@components/sections/Projects.astro";
import { defaultLang, type Lang, languages } from "@i18n/languages";
import { useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	return Object.keys(languages).map((code) => {
		const lang = code as Lang;
		return {
			params: {
				lang: lang === defaultLang ? undefined : lang,
			},
		};
	});
}

const { lang } = Astro.params;
const currentLang: Lang =
	lang && lang in languages ? (lang as Lang) : defaultLang;

const homeEntry = await getEntry("pages", `${currentLang}/home`);
const pageTitle = homeEntry?.data.title || "Portfolio";
const t = useTranslations(currentLang);

const allProjects = await getCollection("projects");
const langProjects = allProjects
	.filter((project) => project.id.startsWith(`${currentLang}/`))
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => {
		const cleanId = project.id.replace(/\.md$/, "");
		const [, ...slugParts] = cleanId.split("/");
		const slug = slugParts.join("/");
		return {
			slug,
			title: project.data.title,
			category: project.data.category,
			description: project.data.description,
			stack: project.data.stack,
			year: project.data.year,
			githubUrl: project.data.githubUrl,
			liveUrl: project.data.liveUrl,
		};
	});

const coreDomains = [
	"Fintech",
	"Logistics & Telemetry",
	"B2B SaaS",
	"High-Load APIs",
	"Design Systems",
	"Real-Time Analytics",
];
---

<Layout title={`${pageTitle}`} lang={currentLang}>
	<main id=\"main-content\">
		<Hero role={t("hero.role")} scrollCueText={t("hero.scroll")} />
		<About
			title={t("about.title")}
			leadText={t("about.lead")}
			text={t("about.text")}
			authorName="ihor kuhel"
			authorRole={t("hero.role")}
			lang={currentLang}
		/>
		<Projects
			badge={t("projects.badge")}
			title={t("projects.title")}
			description={t("projects.description")}
			domains={coreDomains}
			projects={langProjects}
			viewCaseLabel={t("projects.viewCase")}
			viewAllLabel={t("projects.viewAll")}
			lang={currentLang}
		/>
	</main>
</Layout>
