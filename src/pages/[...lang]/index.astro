---
import { getCollection, getEntry } from "astro:content";
import About from "@components/sections/About.astro";
import Directions from "@components/sections/Directions.astro";
import FAQ from "@components/sections/FAQ.astro";
import Footer from "@components/sections/Footer.astro";
import Hero from "@components/sections/Hero.astro";
import Projects from "@components/sections/Projects.astro";
import Showcase from "@components/sections/Showcase.astro";
import { getI18nStaticPaths, resolveLang, useTranslations } from "@i18n/utils";
import { getProjectsByLang } from "@/utils/projects";
import { SITE } from "@/constants/site";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	return getI18nStaticPaths();
}

const currentLang = resolveLang(Astro.params.lang);
const t = useTranslations(currentLang);

const [
	homePageEntry,
	aboutEntry,
	directionsEntry,
	faqEntry,
	projectsEntry,
	showcaseEntry,
	allProjects,
] = await Promise.all([
	getEntry("pages", `${currentLang}/home`),
	getEntry("home", `${currentLang}/about`),
	getEntry("home", `${currentLang}/directions`),
	getEntry("home", `${currentLang}/faq`),
	getEntry("home", `${currentLang}/projects`),
	getEntry("home", `${currentLang}/showcase`),
	getCollection("projects"),
]);

const pageTitle = homePageEntry?.data.title || SITE.role;
const fullTitle = `${SITE.nickname} — ${pageTitle}`;
const pageDescription =
	homePageEntry?.data.description || homePageEntry?.data.seoDescription;

const langProjects = getProjectsByLang(allProjects, currentLang);

const aboutData = aboutEntry?.data;
const directionsData = directionsEntry?.data;
const faqData = faqEntry?.data;
const projectsData = projectsEntry?.data;
const showcaseData = showcaseEntry?.data;
---

<Layout
	title={fullTitle}
	description={pageDescription}
	lang={currentLang}
>
	<main id="main-content">
		<Hero />
		<About
			title={aboutData?.title || ""}
			leadText={aboutData?.lead}
			text={aboutData?.text || ""}
			lang={currentLang}
		/>

		<Projects
			badge={projectsData?.badge || ""}
			title={projectsData?.title || ""}
			description={projectsData?.description || ""}
			domains={projectsData?.domains || []}
			projects={langProjects}
			viewCaseLabel={t("projects.viewCase")}
			viewAllLabel={t("projects.viewAll")}
			lang={currentLang}
		/>
		<Directions
			badge={directionsData?.badge || ""}
			title={directionsData?.title || ""}
			lead={directionsData?.lead || ""}
			directions={directionsData?.items || []}
		/>
		{faqData && (
			<FAQ
				badge={faqData.badge || ""}
				title={faqData.title || ""}
				lead={faqData.lead}
				items={faqData.faqItems || []}
			/>
		)}
		{showcaseData && (
			<Showcase
				badge={showcaseData.badge || ""}
				title={showcaseData.title || ""}
				lead={showcaseData.lead}
				tabs={showcaseData.tabs || []}
				nextLabel={t("showcase.next")}
			/>
		)}
	</main>
	<Footer lang={currentLang} projects={langProjects} />
</Layout>
