---
import { getCollection, getEntry } from "astro:content";
import About from "@components/sections/About.astro";
import Directions from "@components/sections/Directions.astro";
import Hero from "@components/sections/Hero.astro";
import Projects from "@components/sections/Projects.astro";
import Showcase from "@components/sections/Showcase.astro";
import { defaultLang, type Lang, languages } from "@i18n/languages";
import { useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	return Object.keys(languages).map((code) => {
		const lang = code as Lang;
		return {
			params: {
				lang: lang === defaultLang ? undefined : lang,
			},
		};
	});
}

const { lang } = Astro.params;
const currentLang: Lang =
	lang && lang in languages ? (lang as Lang) : defaultLang;

const t = useTranslations(currentLang);

const [
	homePageEntry,
	heroEntry,
	aboutEntry,
	directionsEntry,
	projectsEntry,
	showcaseEntry,
	allProjects,
] = await Promise.all([
	getEntry("pages", `${currentLang}/home`),
	getEntry("home", `${currentLang}/hero`),
	getEntry("home", `${currentLang}/about`),
	getEntry("home", `${currentLang}/directions`),
	getEntry("home", `${currentLang}/projects`),
	getEntry("home", `${currentLang}/showcase`),
	getCollection("projects"),
]);

const pageTitle = homePageEntry?.data.title || "Portfolio";

const langProjects = allProjects
	.filter((project) => project.id.startsWith(`${currentLang}/`))
	.sort((a, b) => a.data.order - b.data.order)
	.map((project) => {
		const cleanId = project.id.replace(/\.md$/, "");
		const [, ...slugParts] = cleanId.split("/");
		const slug = slugParts.join("/");
		return {
			slug,
			title: project.data.title,
			category: project.data.category,
			description: project.data.description,
			stack: project.data.stack,
			year: project.data.year,
			githubUrl: project.data.githubUrl,
			liveUrl: project.data.liveUrl,
		};
	});

const heroData = heroEntry?.data;
const aboutData = aboutEntry?.data;
const directionsData = directionsEntry?.data;
const projectsData = projectsEntry?.data;
const showcaseData = showcaseEntry?.data;
---

<Layout title={`${pageTitle}`} lang={currentLang}>
	<main id="main-content">
		<Hero
			name={heroData?.name}
			role={heroData?.role}
			scrollCueText={heroData?.scrollCueText}
			githubUrl={heroData?.githubUrl}
			linkedinUrl={heroData?.linkedinUrl}
		/>
		<About
			title={aboutData?.title || ""}
			leadText={aboutData?.lead}
			text={aboutData?.text || ""}
			authorName={aboutData?.authorName || "ihor kuhel"}
			authorRole={aboutData?.authorRole ||
				heroData?.role ||
				"Software Developer"}
			lang={currentLang}
		/>

		<Projects
			badge={projectsData?.badge || ""}
			title={projectsData?.title || ""}
			description={projectsData?.description || ""}
			domains={projectsData?.domains || []}
			projects={langProjects}
			viewCaseLabel={t("projects.viewCase")}
			viewAllLabel={t("projects.viewAll")}
			lang={currentLang}
		/>
		<Directions
			badge={directionsData?.badge || ""}
			title={directionsData?.title || ""}
			lead={directionsData?.lead || ""}
			directions={directionsData?.items || []}
		/>
		{showcaseData && (
			<Showcase
				badge={showcaseData.badge || ""}
				title={showcaseData.title || ""}
				lead={showcaseData.lead}
				tabs={showcaseData.tabs || []}
			/>
		)}
	</main>
</Layout>
