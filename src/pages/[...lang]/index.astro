			leadText={t("about.lead")}
			text={t("about.text")}
			authorName="ihor kuhel"
			authorRole={t("hero.role")}
			lang={currentLang}
		/>
		<Directions
			badge={t("directions.badge")}
			title={t("directions.title")}
			lead={t("directions.lead")}
			directions={currentDirections}
		/>
		<Projects
			badge={t("projects.badge")}
			title={t("projects.title")}
			description={t("projects.description")}
			domains={coreDomains}
			projects={langProjects}
			viewCaseLabel={t("projects.viewCase")}
			viewAllLabel={t("projects.viewAll")}
			lang={currentLang}
		/>
	</main>
</Layout>
