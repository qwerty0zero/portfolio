---
import { getCollection, getEntry } from "astro:content";
import Button from "@components/ui/Button.astro";
import IconArrow from "@components/ui/icons/IconArrow.astro";
import ProjectCard from "@components/ui/ProjectCard.astro";
import Footer from "@components/sections/Footer.astro";
import { SITE } from "@/constants/site";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang, type Lang } from "@i18n/languages";
import { getI18nStaticPaths, useTranslations } from "@i18n/utils";
import { getProjectsByLang } from "@/utils/projects";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	return getI18nStaticPaths();
}

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;

const t = useTranslations(currentLang);
const homeUrl = getRelativeLocaleUrl(currentLang, "");

const projectsPageEntry = await getEntry("pages", `${currentLang}/projects`);
const allProjects = await getCollection("projects");
const langProjects = getProjectsByLang(allProjects, currentLang);

const pageTitle = projectsPageEntry?.data.title || t("nav.projects");
const fullTitle = `${pageTitle} — ${SITE.nickname}`;
const seoDescription =
	projectsPageEntry?.data.seoDescription || projectsPageEntry?.data.subtitle;
const catalogBadge = projectsPageEntry?.data.badge;
const catalogSubtitle = projectsPageEntry?.data.subtitle;
---

<Layout title={fullTitle} description={seoDescription} lang={currentLang}>
	<main id="main-content" class="projects-catalog-page">
		<header class="catalog-header">
			<nav class="catalog-nav" aria-label="Breadcrumb">
				<Button href={homeUrl} variant="outline" size="sm">
					<IconArrow size={14} direction="left" />
					<span>{t("project.back")}</span>
				</Button>
			</nav>

			<div class="catalog-title-group">
				{catalogBadge && <span class="catalog-badge text-eyebrow">{catalogBadge}</span>}
				<h1 class="catalog-heading heading-1">
					{projectsPageEntry?.data.title || t("nav.projects")}
				</h1>
				{catalogSubtitle && <p class="catalog-subtitle text-lead">{catalogSubtitle}</p>}
			</div>
		</header>

		<section
			class="catalog-grid-section"
			aria-labelledby="catalog-grid-heading"
		>
			<h2 id="catalog-grid-heading" class="sr-only">
				{projectsPageEntry?.data.title || t("nav.projects")}
			</h2>
			<div class="catalog-grid">
				{langProjects.map((project, index) => (
						<ProjectCard
							index={index + 1}
							title={project.title}
							category={project.category}
							description={project.description}
							stack={project.stack}
							year={project.year}
							slug={project.slug}
							githubUrl={project.githubUrl}
							liveUrl={project.liveUrl}
							viewCaseLabel={t("projects.viewCase")}
							projectUrl={getRelativeLocaleUrl(
								currentLang,
								`projects/${project.slug}`,
							)}
						/>
					))}
			</div>
		</section>
	</main>
	<Footer lang={currentLang} projects={langProjects} />
</Layout>

<style>
.projects-catalog-page {
	padding: var(--space-16) var(--space-12) var(--space-24);
	min-height: 100vh;
}

.catalog-header {
	display: flex;
	flex-direction: column;
	gap: var(--space-8);
	border-bottom: 1px solid var(--border);
	padding-bottom: var(--space-12);
	margin-bottom: var(--space-12);
}

.catalog-nav {
	display: flex;
	align-items: center;
}

.catalog-title-group {
	display: flex;
	flex-direction: column;
	gap: var(--space-4);
	max-width: 800px;
}

.catalog-heading {
	margin: 0;
}

.catalog-subtitle {
	margin: 0;
}

.catalog-grid-section {
	width: 100%;
}

.catalog-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
	gap: var(--space-8);
	width: 100%;
}

@media (max-width: 768px) {
	.projects-catalog-page {
		padding: var(--space-8) var(--space-4) var(--space-16);
	}

	.catalog-header {
		padding-bottom: var(--space-8);
		margin-bottom: var(--space-8);
		gap: var(--space-6);
	}

	.catalog-grid {
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}
}
</style>
