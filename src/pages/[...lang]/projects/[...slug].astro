---
import { getCollection, getEntry } from "astro:content";
import Footer from "@components/sections/Footer.astro";
import { SITE } from "@/constants/site";
import { defaultLang, type Lang } from "@i18n/languages";
import { getProjectsByLang, parseProjectSlug } from "@/utils/projects";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	const allProjects = await getCollection("projects");

	return allProjects.map((project) => {
		const { lang, slug } = parseProjectSlug(project.id);
		return {
			params: {
				lang: lang === defaultLang ? undefined : lang,
				slug,
			},
		};
	});
}

const currentLang = (Astro.currentLocale ?? defaultLang) as Lang;
const { slug } = Astro.params;

const [project, allProjects] = await Promise.all([
	slug ? getEntry("projects", `${currentLang}/${slug}`) : null,
	getCollection("projects"),
]);

const langProjects = getProjectsByLang(allProjects, currentLang);

const projectData = project?.data;
const projectTitle = projectData
	? `${projectData.title} — ${SITE.nickname}`
	: SITE.nickname;
const projectDescription =
	projectData?.seoDescription || projectData?.description;
---

<Layout
	title={projectTitle}
	description={projectDescription}
	ogType="article"
	lang={currentLang}
>
	<main id="main-content">
		<h1>{projectData?.title}</h1>
	</main>
	<Footer lang={currentLang} projects={langProjects} />
</Layout>
