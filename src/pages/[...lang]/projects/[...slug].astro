---
import { getCollection, getEntry } from "astro:content";
import { defaultLang, type Lang, languages } from "@i18n/languages";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
	const allProjects = await getCollection("projects");

	return allProjects.map((project) => {
		const cleanId = project.id.replace(/\.md$/, "");
		const [langCode, ...slugParts] = cleanId.split("/");
		const slug = slugParts.join("/");
		const lang = langCode as Lang;

		return {
			params: {
				lang: lang === defaultLang ? undefined : lang,
				slug: slug,
			},
		};
	});
}

const { lang, slug } = Astro.params;
const currentLang: Lang =
	lang && lang in languages ? (lang as Lang) : defaultLang;

const project = slug
	? await getEntry("projects", `${currentLang}/${slug}`)
	: null;
const projectTitle = project?.data.title || "Project";
---

<Layout title={projectTitle} lang={currentLang}>
	<h1>{projectTitle}</h1>
</Layout>
