---
import Badge from "@components/ui/Badge.astro";

export interface Props {
	index: string;
	title: string;
	tagline: string;
	description: string;
	skills: string[];
	responsibilities: string[];
	class?: string;
}

const {
	index,
	title,
	tagline,
	description,
	skills = [],
	responsibilities = [],
	class: className = "",
} = Astro.props;
---

<article class:list={["direction-card", className]}>
	<div class="card-header">
		<div class="card-header-main">
			<span class="card-index">{index}</span>
			<h3 class="card-title heading-3">{title}</h3>
		</div>
		<span class="card-tagline text-mono-sm">{tagline}</span>
	</div>

	<div class="card-content">
		<div class="card-description-block">
			<h4 class="block-label text-mono-label">Architecture & Philosophy</h4>
			<p class="card-description text-body-lg">{description}</p>
		</div>

		<div class="card-details-grid">
			{responsibilities && responsibilities.length > 0 && (
					<div class="details-column">
						<h4 class="block-label text-mono-label">Core Responsibilities</h4>
						<ul class="responsibilities-list">
							{responsibilities.map((item) => (
								<li class="responsibility-item text-body-sm">
									<span class="bullet" aria-hidden="true">
										■
									</span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
				)}

			{skills && skills.length > 0 && (
					<div class="details-column">
						<h4 class="block-label text-mono-label">Key Stack & Methodology</h4>
						<div class="skills-chips">
							{skills.map((skill) => (
								<Badge text={skill} variant="tertiary" size="sm" />
							))}
						</div>
					</div>
				)}
		</div>
	</div>
</article>

<style>
.direction-card {
	display: flex;
	flex-direction: column;
	background-color: var(--background-secondary);
	border: 1px solid var(--border-strong);
	padding: var(--space-8);
	position: relative;
	transition:
		border-color var(--transition-fast),
		background-color var(--transition-fast);
	width: 100%;
}

.direction-card:hover {
	background-color: var(--background-elevated);
	border-color: var(--accent);
}

.card-header {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	flex-wrap: wrap;
	gap: var(--space-4);
	padding-bottom: var(--space-6);
	border-bottom: 1px solid var(--border);
}

.card-header-main {
	display: flex;
	align-items: baseline;
	gap: var(--space-4);
}

.card-index {
	font-family: var(--font-mono);
	font-size: var(--font-size-h4);
	font-weight: var(--font-weight-bold);
	color: var(--accent);
	line-height: 1;
}

.card-title {
	margin: 0;
}

.card-tagline {
	text-transform: uppercase;
	color: var(--text-dim);
}

.card-content {
	display: flex;
	flex-direction: column;
	gap: var(--space-6);
	padding-top: var(--space-6);
}

.card-description-block {
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}

.block-label {
	margin: 0;
}

.card-description {
	margin: 0;
	color: var(--text);
}

.card-details-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: var(--space-8);
	padding-top: var(--space-4);
	border-top: 1px dashed var(--border-dim);
}

.details-column {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}

.responsibilities-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}

.responsibility-item {
	display: flex;
	align-items: flex-start;
	gap: var(--space-2);
}

.bullet {
	color: var(--accent);
	font-size: var(--font-size-2xs);
	line-height: 1.8;
	flex-shrink: 0;
}

.skills-chips {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-2);
}

@media (max-width: 768px) {
	.direction-card {
		padding: var(--space-6);
	}

	.card-header {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding-bottom: var(--space-4);
	}

	.card-header-main {
		gap: var(--space-3);
	}

	.card-details-grid {
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}
}
</style>
