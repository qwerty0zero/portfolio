---
export interface Props {
	index: string;
	title: string;
	tagline: string;
	description: string;
	skills: string[];
	responsibilities: string[];
	class?: string;
}

const {
	index,
	title,
	tagline,
	description,
	skills = [],
	responsibilities = [],
	class: className = "",
} = Astro.props;
---

<article class:list={["direction-card", className]}>
	<div class="card-header">
		<div class="card-header-main">
			<span class="card-index">{index}</span>
			<h3 class="card-title">{title}</h3>
		</div>
		<span class="card-tagline">{tagline}</span>
	</div>

	<div class="card-content">
		<div class="card-description-block">
			<h4 class="block-label">Architecture & Philosophy</h4>
			<p class="card-description">{description}</p>
		</div>

		<div class="card-details-grid">
			{responsibilities && responsibilities.length > 0 && (
				<div class="details-column">
					<h4 class="block-label">Core Responsibilities</h4>
					<ul class="responsibilities-list">
						{responsibilities.map((item) => (
							<li class="responsibility-item">
								<span class="bullet" aria-hidden="true">■</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			)}

			{skills && skills.length > 0 && (
				<div class="details-column">
					<h4 class="block-label">Key Stack & Methodology</h4>
					<div class="skills-chips">
						{skills.map((skill) => (
							<span class="skill-chip">{skill}</span>
						))}
					</div>
				</div>
			)}
		</div>
	</div>
</article>

<style>
.direction-card {
	display: flex;
	flex-direction: column;
	background-color: var(--background-secondary);
	border: 1px solid var(--border-strong);
	padding: var(--space-8);
	box-sizing: border-box;
	position: relative;
	transition:
		border-color var(--transition-fast),
		background-color var(--transition-fast);
	width: 100%;
}

.direction-card:hover {
	background-color: var(--background-elevated);
	border-color: var(--accent);
}

.card-header {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	flex-wrap: wrap;
	gap: var(--space-4);
	padding-bottom: var(--space-6);
	border-bottom: 1px solid var(--border);
}

.card-header-main {
	display: flex;
	align-items: baseline;
	gap: var(--space-4);
}

.card-index {
	font-family: var(--font-mono);
	font-size: clamp(1.25rem, 2vw, 1.75rem);
	font-weight: 700;
	color: var(--accent);
	line-height: 1;
}

.card-title {
	font-family: var(--font-heading);
	font-size: clamp(1.5rem, 2.5vw, 2.25rem);
	line-height: 1.15;
	color: var(--text);
	text-transform: uppercase;
	margin: 0;
}

.card-tagline {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: var(--text-dim);
}

.card-content {
	display: flex;
	flex-direction: column;
	gap: var(--space-6);
	padding-top: var(--space-6);
}

.card-description-block {
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}

.block-label {
	font-family: var(--font-mono);
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--text-muted);
	margin: 0;
}

.card-description {
	font-family: var(--font-body);
	font-size: clamp(1.0625rem, 1.25vw, 1.25rem);
	line-height: 1.55;
	color: var(--text);
	margin: 0;
}

.card-details-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: var(--space-8);
	padding-top: var(--space-4);
	border-top: 1px dashed var(--border-dim);
}

.details-column {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}

.responsibilities-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}

.responsibility-item {
	display: flex;
	align-items: flex-start;
	gap: var(--space-2);
	font-family: var(--font-body);
	font-size: 0.9375rem;
	line-height: 1.45;
	color: var(--text-dim);
}

.bullet {
	color: var(--accent);
	font-size: 0.625rem;
	line-height: 1.8;
	flex-shrink: 0;
}

.skills-chips {
	display: flex;
	flex-wrap: wrap;
	gap: var(--space-2);
}

.skill-chip {
	font-family: var(--font-mono);
	font-size: 0.75rem;
	color: var(--text);
	background-color: var(--background-tertiary);
	border: 1px solid var(--border);
	padding: 4px 10px;
	letter-spacing: 0.02em;
}

@media (max-width: 768px) {
	.direction-card {
		padding: var(--space-6);
	}

	.card-header {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding-bottom: var(--space-4);
	}

	.card-header-main {
		gap: var(--space-3);
	}

	.card-details-grid {
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}
}
</style>
