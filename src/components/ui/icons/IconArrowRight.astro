---
export interface Props {
	size?: number;
	strokeWidth?: number;
	direction?: "left" | "right";
	class?: string;
}

const {
	size = 14,
	strokeWidth = 2,
	direction = "right",
	class: className = "",
} = Astro.props;

const path =
	direction === "left" ? "M19 12H5M12 19l-7-7 7-7" : "M5 12h14M12 5l7 7-7 7";
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	aria-hidden="true"
>
	<path d={path}></path>
</svg>
