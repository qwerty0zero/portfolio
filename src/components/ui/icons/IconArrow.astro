---
export interface Props {
	size?: number;
	strokeWidth?: number;
	direction?: "left" | "right" | "up" | "down";
	class?: string;
}

const {
	size = 14,
	strokeWidth = 2,
	direction = "right",
	class: className = "",
} = Astro.props;

const rotationMap: Record<string, string> = {
	right: "rotate(0deg)",
	down: "rotate(90deg)",
	left: "rotate(180deg)",
	up: "rotate(270deg)",
};

const transform = rotationMap[direction] ?? "none";
---

<svg
	class:list={["icon-arrow", className]}
	style={{ transform }}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	aria-hidden="true"
>
	<path d="M5 12h14M12 5l7 7-7 7"></path>
</svg>

<style>
.icon-arrow {
	transform-origin: center;
	transition: transform var(--transition-fast);
	flex-shrink: 0;
}
</style>
