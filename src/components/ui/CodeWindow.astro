---
import IconFileCode from "@components/ui/icons/IconFileCode.astro";

export interface Props {
	fileName?: string;
	lang: string;
	title: string;
	text: string;
	author: string;
	role: string;
	class?: string;
}

const {
	fileName = "index.html",
	lang,
	title,
	text,
	author,
	role,
	class: className = "",
} = Astro.props;
---

<div class:list={["code-window", className]}>
	<div class="code-window-header">
		<div class="code-window-controls" aria-hidden="true">
			<span class="control-dot close">
				<svg
					class="control-icon"
					aria-hidden="true"
					viewBox="0 0 12 12"
					width="7"
					height="7"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
				>
					<line x1="2.5" y1="2.5" x2="9.5" y2="9.5"></line>
					<line x1="9.5" y1="2.5" x2="2.5" y2="9.5"></line>
				</svg>
			</span>
			<span class="control-dot minimize">
				<svg
					class="control-icon"
					aria-hidden="true"
					viewBox="0 0 12 12"
					width="7"
					height="7"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
				>
					<line x1="2" y1="6" x2="10" y2="6"></line>
				</svg>
			</span>
			<span class="control-dot maximize">
				<svg
					class="control-icon"
					aria-hidden="true"
					viewBox="0 0 12 12"
					width="6"
					height="6"
					fill="currentColor"
				>
					<path
						d="M1.5 1.5h4v1.5h-2.5v2.5h-1.5v-4zM6.5 10.5h4v-4h-1.5v2.5h-2.5v1.5z"
					></path>
				</svg>
			</span>
		</div>
		<div class="code-window-tab">
			<IconFileCode size={14} class="file-icon" />
			<span class="tab-title">{fileName}</span>
		</div>
	</div>

	<div class="code-window-body">
		<div class="line-numbers" aria-hidden="true">
			<span>01</span>
			<span>02</span>
			<span>03</span>
			<span>04</span>
			<span>05</span>
			<span>06</span>
			<span>07</span>
			<span>08</span>
			<span>09</span>
			<span>10</span>
			<span>11</span>
			<span>12</span>
		</div>
		<pre
			class="code-content"
		><code><span class="token-doctype">&lt;!DOCTYPE html&gt;</span>
<span class="token-tag">&lt;html</span> <span class="token-attr">lang</span>=<span class="token-string">"{lang}"</span><span class="token-tag">&gt;</span>
  <span class="token-tag">&lt;head&gt;</span>
    <span class="token-tag">&lt;meta</span> <span class="token-attr">name</span>=<span class="token-string">"author"</span> <span class="token-attr">content</span>=<span class="token-string">"{author}"</span> <span class="token-tag">/&gt;</span>
    <span class="token-tag">&lt;meta</span> <span class="token-attr">name</span>=<span class="token-string">"role"</span> <span class="token-attr">content</span>=<span class="token-string">"{role}"</span> <span class="token-tag">/&gt;</span>
  <span class="token-tag">&lt;/head&gt;</span>
  <span class="token-tag">&lt;body&gt;</span>
    <span class="token-tag">&lt;h1&gt;</span><span class="token-text">{title}</span><span class="token-tag">&lt;/h1&gt;</span>
    <span class="token-tag">&lt;p&gt;</span>
      <span class="token-text wrap-text">{text}</span>
    <span class="token-tag">&lt;/p&gt;</span>
  <span class="token-tag">&lt;/body&gt;</span>
<span class="token-tag">&lt;/html&gt;</span></code></pre>
	</div>
</div>

<style>
.code-window {
	width: 100%;
	max-width: 100%;
	min-width: 0;
	background-color: var(--background-secondary);
	border: 1px solid var(--border);
	overflow: hidden;
	transition:
		border-color var(--transition-fast),
		background-color var(--transition-fast);
}

.code-window:hover {
	border-color: var(--border-strong);
}

.code-window-header {
	display: flex;
	align-items: center;
	background-color: var(--background-tertiary);
	border-bottom: 1px solid var(--border);
	padding: var(--space-2) var(--space-4);
	gap: var(--space-4);
	min-height: 38px;
}

.code-window-controls {
	display: flex;
	align-items: center;
	gap: 6px;
	padding: 4px;
}

.control-dot {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 12px;
	height: 12px;
	border-radius: var(--radius-full);
	transition:
		filter var(--transition-fast),
		background-color var(--transition-fast);
}

.control-dot.close {
	background-color: var(--window-control-close);
}

.control-dot.minimize {
	background-color: var(--window-control-minimize);
}

.control-dot.maximize {
	background-color: var(--window-control-maximize);
}

.control-icon {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	opacity: 0;
	color: var(--window-control-symbol);
	pointer-events: none;
	transition: opacity var(--transition-fast);
}

.code-window-controls:hover .control-icon {
	opacity: 1;
}

.control-dot.close:hover {
	background-color: var(--window-control-close-hover);
}

.control-dot.minimize:hover {
	background-color: var(--window-control-minimize-hover);
}

.control-dot.maximize:hover {
	background-color: var(--window-control-maximize-hover);
}

.code-window-tab {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	background-color: var(--background-secondary);
	border-inline: 1px solid var(--border);
	border-top: 2px solid var(--accent);
	padding: var(--space-2) var(--space-3);
	margin-block: calc(-1 * var(--space-2));
	font-family: var(--font-mono);
	font-size: var(--font-size-sm);
	color: var(--text);
}

.file-icon {
	color: var(--accent);
	flex-shrink: 0;
}

.tab-title {
	font-size: var(--font-size-xs);
	font-weight: var(--font-weight-medium);
}

.code-window-body {
	display: flex;
	align-items: stretch;
	padding: var(--space-4) 0;
	overflow-x: auto;
	background-color: var(--background-secondary);
	min-width: 0;
}

.line-numbers {
	display: flex;
	flex-direction: column;
	padding: 0 var(--space-4);
	border-right: 1px solid var(--border-dim);
	color: var(--text-muted);
	font-family: var(--font-mono);
	font-size: var(--font-size-sm);
	line-height: 1.6;
	user-select: none;
	text-align: right;
	flex-shrink: 0;
}

.code-content {
	margin: 0;
	padding: 0 var(--space-4);
	font-family: var(--font-mono);
	font-size: var(--font-size-sm);
	line-height: 1.6;
	color: var(--text);
	overflow-x: hidden;
	flex: 1;
	min-width: 0;
	white-space: pre-wrap;
	word-break: break-word;
}

.token-doctype {
	color: var(--text-muted);
}

.token-tag {
	color: var(--accent);
	font-weight: var(--font-weight-bold);
}

.token-attr {
	color: var(--text-dim);
}

.token-string {
	color: var(--text);
	text-decoration: underline;
	text-decoration-color: var(--border-strong);
}

.token-text {
	color: var(--text);
}

.wrap-text {
	display: inline-block;
	word-break: break-word;
}

@media (max-width: 768px) {
	.code-window-header {
		padding: var(--space-2);
		gap: var(--space-2);
	}

	.line-numbers {
		padding: 0 var(--space-2);
		font-size: var(--font-size-xs);
	}

	.code-content {
		padding: 0 var(--space-2);
		font-size: var(--font-size-xs);
	}
}
</style>
