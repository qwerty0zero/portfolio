---
import type { HTMLAttributes } from "astro/types";

export interface SelectOption {
	value: string;
	label: string;
	selected?: boolean;
	disabled?: boolean;
	dataLang?: string;
}

export interface Props extends HTMLAttributes<"select"> {
	options: SelectOption[];
	size?: "sm" | "md" | "lg";
	class?: string;
	wrapperClass?: string;
	ariaLabel?: string;
}

const {
	options = [],
	size = "md",
	class: className = "",
	wrapperClass = "",
	ariaLabel,
	id,
	name,
	...rest
} = Astro.props;
---

<div class:list={["select-wrapper", `select-wrapper--${size}`, wrapperClass]}>
	<select
		id={id}
		name={name}
		aria-label={ariaLabel}
		class:list={["select-control", `select--${size}`, className]}
		{...rest}
	>
		{options.map((opt) => (
				<option
					value={opt.value}
					selected={opt.selected}
					disabled={opt.disabled}
					data-lang={opt.dataLang}
				>
					{opt.label}
				</option>
			))}
	</select>
	<span class="select-arrow" aria-hidden="true">
		<svg
			aria-hidden="true"
			width="10"
			height="6"
			viewBox="0 0 10 6"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<polyline points="1 1 5 5 9 1"></polyline>
		</svg>
	</span>
</div>

<style>
.select-wrapper {
	position: relative;
	display: inline-flex;
	align-items: center;
	vertical-align: middle;
}

.select-control {
	width: 100%;
	appearance: none;
	-webkit-appearance: none;
	-moz-appearance: none;
	background-color: var(--background-tertiary);
	color: var(--text);
	border: 1px solid var(--border);
	border-radius: var(--radius-none);
	font-family: var(--font-mono);
	font-weight: 500;
	letter-spacing: 0.04em;
	cursor: pointer;
	transition:
		border-color var(--transition-fast),
		background-color var(--transition-fast),
		color var(--transition-fast);
}

.select-control:hover {
	border-color: var(--border-strong);
	background-color: var(--background-elevated);
}

.select-control:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: 2px;
	border-color: var(--accent);
}

.select-control:disabled {
	opacity: 0.5;
	cursor: not-allowed;
	pointer-events: none;
}

.select-control option {
	background-color: var(--background-secondary);
	color: var(--text);
	font-family: var(--font-mono);
}

/* Sizes */
.select--sm {
	height: 32px;
	padding: 0 var(--space-8) 0 var(--space-3);
	font-size: 0.75rem;
}

.select--md {
	height: 40px;
	padding: 0 var(--space-8) 0 var(--space-4);
	font-size: 0.8125rem;
}

.select--lg {
	height: 48px;
	padding: 0 var(--space-10) 0 var(--space-6);
	font-size: 0.875rem;
}

/* Arrow Icon */
.select-arrow {
	position: absolute;
	right: var(--space-3);
	top: 50%;
	transform: translateY(-50%);
	color: var(--text-dim);
	pointer-events: none;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	transition:
		color var(--transition-fast),
		transform var(--transition-fast);
}

.select-wrapper--lg .select-arrow {
	right: var(--space-4);
}

.select-control:hover + .select-arrow,
.select-control:focus-visible + .select-arrow {
	color: var(--accent);
}

@media (hover: none) or (pointer: coarse) {
	.select-control {
		min-height: 44px;
	}
}
</style>
