---
import Button from "@components/ui/Button.astro";
import IconArrow from "@components/ui/icons/IconArrow.astro";
import IconExternalLink from "@components/ui/icons/IconExternalLink.astro";
import IconGithub from "@components/ui/icons/IconGithub.astro";

export interface Props {
	index: number;
	title: string;
	category: string;
	description: string;
	stack?: string[];
	year: string;
	slug: string;
	githubUrl?: string;
	liveUrl?: string;
	viewCaseLabel: string;
	projectUrl: string;
	class?: string;
}

const {
	index,
	title,
	category,
	description,
	stack = [],
	year,
	githubUrl,
	liveUrl,
	viewCaseLabel,
	projectUrl,
	class: className = "",
} = Astro.props;

const formattedIndex = String(index).padStart(2, "0");
---

<article class:list={["project-card", className]}>
	<div class="card-header">
		<div class="card-meta">
			<span class="card-index">{formattedIndex}</span>
			<span class="card-category">{category}</span>
		</div>
		<span class="card-year">{year}</span>
	</div>

	<div class="card-body">
		<h3 class="card-title">
			<a href={projectUrl} class="card-title-link">
				{title}
			</a>
		</h3>
		<p class="card-description">{description}</p>
	</div>

	<div class="card-footer">
		{stack && stack.length > 0 && (
			<div class="card-stack" aria-label="Технологический стек">
				{stack.map((tech) => (
					<span class="stack-tag">{tech}</span>
				))}
			</div>
		)}

		<div class="card-actions">
			<Button
				href={projectUrl}
				variant="primary"
				size="md"
				class="primary-action"
			>
				<span>{viewCaseLabel}</span>
				<IconArrow size={14} />
			</Button>

			{liveUrl && (
				<Button
					href={liveUrl}
					variant="icon"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Live Demo"
				>
					<IconExternalLink size={14} />
				</Button>
			)}

			{githubUrl && (
				<Button
					href={githubUrl}
					variant="icon"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub Repository"
				>
					<IconGithub size={14} />
				</Button>
			)}
		</div>
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: clamp(340px, 32vw, 440px);
		height: 480px;
		background-color: var(--background-secondary);
		border: 1px solid var(--border);
		padding: var(--space-8);
		box-sizing: border-box;
		flex-shrink: 0;
		position: relative;
		transition:
			border-color var(--transition-fast),
			background-color var(--transition-fast);
	}

	.project-card:hover {
		border-color: var(--border-strong);
		background-color: var(--background-elevated);
	}

	/* Card Header */
	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--border);
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.card-index {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--accent);
		font-weight: 700;
	}

	.card-category {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-dim);
	}

	.card-year {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	/* Card Body */
	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-block: auto;
	}

	.card-title {
		font-family: var(--font-heading);
		font-size: 1.5rem;
		line-height: 1.25;
		margin: 0;
	}

	.card-title-link {
		color: var(--text);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.card-title-link:hover {
		color: var(--accent);
	}

	.card-description {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-dim);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Card Footer */
	.card-footer {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}

	.card-stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.stack-tag {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--text-dim);
		background-color: var(--background-tertiary);
		padding: 2px 8px;
		border: 1px solid var(--border);
		letter-spacing: 0.02em;
	}

	.card-actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.primary-action {
		flex: 1;
	}

	@media (max-width: 768px) {
		.project-card {
			width: 100%;
			max-width: 100%;
			height: auto;
			min-height: auto;
			padding: var(--space-6);
			gap: var(--space-6);
		}

		.card-body {
			margin-block: var(--space-2);
		}

		.card-description {
			-webkit-line-clamp: 6;
		}

		.card-footer {
			gap: var(--space-4);
		}
	}
</style>
