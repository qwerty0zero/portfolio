---
export interface Props {
	text?: string;
	variant?: "accent" | "muted" | "outline";
	size?: "sm" | "md";
	class?: string;
}

const {
	text,
	variant = "accent",
	size = "md",
	class: className = "",
} = Astro.props;
---

<span class:list={["badge", `badge--${variant}`, `badge--${size}`, className]}>
	<slot>{text}</slot>
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		box-sizing: border-box;
		width: fit-content;
		user-select: none;
	}

	/* Sizes */
	.badge--md {
		font-size: 0.8125rem;
		line-height: 1.2;
	}

	.badge--sm {
		font-size: 0.75rem;
		line-height: 1.2;
	}

	/* Variants */
	.badge--accent {
		color: var(--accent);
	}

	.badge--muted {
		color: var(--text-muted);
	}

	.badge--outline {
		color: var(--text);
		background-color: var(--background-secondary);
		border: 1px solid var(--border);
		padding: 4px 10px;
		letter-spacing: 0.04em;
	}
</style>
