---
import CodeWindow from "@components/ui/CodeWindow.astro";

export interface Props {
	title: string;
	leadText?: string;
	text: string;
	authorName: string;
	authorRole: string;
	lang: string;
	id?: string;
	class?: string;
}

const {
	title,
	leadText,
	text,
	authorName,
	authorRole,
	lang,
	id = "about",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["about", className]}
	aria-labelledby="about-heading"
>
	<div class="about-container">
		<div class="about-grid">
			<div class="about-content">
				<h2 id="about-heading" class="about-title">
					{title}
				</h2>
				{leadText && <p class="about-lead">{leadText}</p>}
				<div class="about-text">
					<p>{text}</p>
				</div>
			</div>

			<div class="about-code-preview" aria-hidden="true">
				<CodeWindow
					fileName="index.html"
					lang={lang}
					title={title}
					text={text}
					author={authorName}
					role={authorRole}
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		width: 100%;
		background-color: var(--background);
		padding: var(--space-24) var(--space-12);
		border-top: 1px solid var(--border);
		box-sizing: border-box;
	}

	.about-container {
		width: 100%;
		margin-inline: auto;
		min-width: 0;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: var(--space-12);
		align-items: center;
		min-width: 0;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
		min-width: 0;
	}

	.about-title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3.5rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--text);
		text-transform: uppercase;
		margin: 0;
		word-break: break-word;
	}

	.about-lead {
		font-family: var(--font-body);
		font-size: clamp(1.125rem, 1.8vw, 1.375rem);
		font-weight: 700;
		color: var(--accent);
		line-height: 1.4;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0;
		word-break: break-word;
	}

	.about-text {
		font-family: var(--font-body);
		font-size: clamp(1rem, 1.2vw, 1.125rem);
		line-height: 1.6;
		color: var(--text-dim);
		word-break: break-word;
	}

	.about-text p {
		margin: 0;
	}

	.about-code-preview {
		width: 100%;
		min-width: 0;
		display: flex;
		justify-content: center;
	}

	@media (max-width: 1024px) {
		\ .about {
			padding: var(--space-16) var(--space-8);
		}

		.about-grid {
			gap: var(--space-8);
		}
	}

	@media (max-width: 768px) {
		.about {
			padding: var(--space-12) var(--space-4);
		}

		.about-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-8);
		}
	}
</style>
