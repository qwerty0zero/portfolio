---
import CodeWindow from "@components/ui/CodeWindow.astro";
import { SITE } from "@/constants/site";

export interface Props {
	title: string;
	leadText?: string;
	text: string;
	lang: string;
	id?: string;
	class?: string;
}

const {
	title,
	leadText,
	text,
	lang,
	id = "about",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["about", className]}
	aria-labelledby="about-heading"
>
	<div class="about-container">
		<div class="about-grid">
			<div class="about-content">
				<h2 id="about-heading" class="about-title heading-2">
					{title}
				</h2>
				{leadText && <p class="about-lead text-lead-accent">{leadText}</p>}
				<div class="about-text text-body-lg">
					<p>{text}</p>
				</div>
			</div>

			<div class="about-code-preview" aria-hidden="true">
				<CodeWindow
					fileName="index.html"
					lang={lang}
					title={title}
					text={text}
					author={SITE.author}
					role={SITE.role}
				/>
			</div>
		</div>
	</div>
</section>

<style>
.about-container {
	width: 100%;
	margin-inline: auto;
	min-width: 0;
}

.about-grid {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	gap: var(--space-12);
	align-items: center;
	min-width: 0;
}

.about-content {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-6);
	min-width: 0;
}

.about-title {
	margin: 0;
	word-break: break-word;
}

.about-lead {
	margin: 0;
	word-break: break-word;
}

.about-text {
	word-break: break-word;
}

.about-text p {
	margin: 0;
}

.about-code-preview {
	width: 100%;
	min-width: 0;
	display: flex;
	justify-content: center;
}

@media (max-width: 1024px) {
	.about {
		padding: var(--space-16) var(--space-8);
	}

	.about-grid {
		gap: var(--space-8);
	}
}

@media (max-width: 768px) {
	.about {
		padding: var(--space-12) var(--space-4);
	}

	.about-grid {
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-8);
	}
}
</style>
