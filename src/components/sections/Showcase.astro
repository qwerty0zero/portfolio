---
import type { ShowcaseTabItem } from "@/content.config";
import Badge from "@components/ui/Badge.astro";
import BenchmarkChart from "@components/ui/BenchmarkChart.astro";
import ShowcaseTabs from "@components/ui/ShowcaseTabs.astro";

export interface Props {
	badge: string;
	title: string;
	lead?: string;
	tabs: ShowcaseTabItem[];
	id?: string;
	class?: string;
}

const {
	badge,
	title,
	lead,
	tabs,
	id = "showcase",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["showcase-section", className]}
	aria-labelledby="showcase-heading"
>
	<div class="showcase-container">
		<div class="showcase-header">
			<Badge text={badge} />
			<h2 id="showcase-heading" class="showcase-title">{title}</h2>
			{lead && <p class="showcase-lead">{lead}</p>}
		</div>

		<div class="showcase-grid">
			<!-- Left Navigation Column -->
			<div class="showcase-nav-col">
				<ShowcaseTabs tabs={tabs} />
			</div>

			<!-- Right Content Column -->
			<div class="showcase-panels-col">
				<div class="showcase-panels-wrapper">
					{tabs.map((tab, index) => (
						<article
							role="tabpanel"
							id={`showcase-panel-${index}`}
							aria-labelledby={`showcase-tab-${index}`}
							class:list={["showcase-panel", { "is-active": index === 0 }]}
							tabindex={index === 0 ? 0 : -1}
							hidden={index !== 0}
						>
							<div class="panel-header">
								<span class="panel-tag">{tab.index} / 03</span>
								<h3 class="panel-heading">{tab.heading}</h3>
							</div>

							<p class="panel-text">{tab.text}</p>

							{/* Tab 1: Engineering Manifesto principles */}
							{index === 0 && (
								<div class="manifesto-card">
									<div class="manifesto-header">
										<span class="manifesto-badge">CORE PRINCIPLES</span>
									</div>
									<ul class="manifesto-list">
										<li>
											<strong class="manifesto-highlight">Zero Third-Party UI:</strong> Полная архитектурная свобода без ограничений готовых дизайн-систем.
										</li>
										<li>
											<strong class="manifesto-highlight">Strict Geometry:</strong> Бескомпромиссная сетка, выверенные пропорции и прямолинейные формы.
										</li>
										<li>
											<strong class="manifesto-highlight">Extreme Speed:</strong> Оптимизация каждого байта в критическом пути рендеринга.
										</li>
									</ul>
								</div>
							)}

							{/* Tab 2: Benchmark Chart */}
							{tab.metrics && <BenchmarkChart metrics={tab.metrics} />}

							{/* Tab 3: AI Highlights */}
							{tab.highlights && (
								<div class="highlights-grid">
									{tab.highlights.map((item) => (
										<div class="highlight-card">
											<span class="highlight-badge">{item.badge}</span>
											<h4 class="highlight-title">{item.title}</h4>
											<p class="highlight-desc">{item.description}</p>
										</div>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function setupShowcase() {
		const section = document.getElementById("showcase");
		if (!section) return;

		const tabs = Array.from(
			section.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
		);
		const panels = Array.from(
			section.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
		);

		if (tabs.length === 0 || panels.length === 0) return;

		const tabsContainer = section.querySelector<HTMLElement>(".showcase-tabs");
		const panelsWrapper = section.querySelector<HTMLElement>(
			".showcase-panels-wrapper",
		);
		const interactiveTargets = [tabsContainer, panelsWrapper].filter(
			(el): el is HTMLElement => el !== null,
		);

		let currentIndex = 0;
		let isTransitioning = false;
		let isPaused = false;
		let isVisible = false;
		let isHovered = false;
		let isStarted = false;
		let timerId: ReturnType<typeof setTimeout> | null = null;
		let startTime = 0;
		const TIMER_DURATION = 10000; // 10s auto-switch
		let remainingTime = TIMER_DURATION;
		const TRANSITION_DURATION = 200; // 200ms animation guard

		function clearTimer() {
			if (timerId !== null) {
				clearTimeout(timerId);
				timerId = null;
			}
		}

		function restartTimerAnimation(tabEl: HTMLElement) {
			tabEl.classList.remove("is-timing", "is-paused");
			// Force DOM reflow to restart CSS animation
			void tabEl.offsetWidth;
			tabEl.classList.add("is-timing");
		}

		function isReducedMotion(): boolean {
			return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		}

		function pauseTimer() {
			if (isPaused || timerId === null) return;
			isPaused = true;
			const elapsed = performance.now() - startTime;
			remainingTime = Math.max(0, remainingTime - elapsed);
			clearTimer();

			const currentTab = tabs[currentIndex];
			if (currentTab) {
				currentTab.classList.add("is-paused");
			}
		}

		function resumeTimer() {
			if (!isPaused || !isVisible || isHovered || isReducedMotion()) return;
			isPaused = false;

			const currentTab = tabs[currentIndex];
			if (currentTab) {
				currentTab.classList.remove("is-paused");
			}

			if (remainingTime <= 50) {
				const nextIndex = (currentIndex + 1) % tabs.length;
				switchTab(nextIndex, false);
			} else {
				startTime = performance.now();
				timerId = setTimeout(() => {
					const nextIndex = (currentIndex + 1) % tabs.length;
					switchTab(nextIndex, false);
				}, remainingTime);
			}
		}

		function startTimer(duration = TIMER_DURATION) {
			clearTimer();
			isPaused = false;
			remainingTime = duration;

			const currentTab = tabs[currentIndex];
			if (currentTab) {
				restartTimerAnimation(currentTab);
			}

			if (!isVisible || isReducedMotion()) return;

			if (isHovered) {
				// If currently hovering tab or content, keep paused at 0%
				isPaused = true;
				if (currentTab) {
					currentTab.classList.add("is-paused");
				}
				return;
			}

			startTime = performance.now();
			timerId = setTimeout(() => {
				const nextIndex = (currentIndex + 1) % tabs.length;
				switchTab(nextIndex, false);
			}, remainingTime);
		}

		function switchTab(newIndex: number, isManual = true) {
			if (newIndex === currentIndex && isManual) {
				// Clicked on same tab: reset timer only
				clearTimer();
				startTimer(TIMER_DURATION);
				return;
			}

			if (isTransitioning) return;
			isTransitioning = true;
			clearTimer();

			// Deactivate previous
			const prevTab = tabs[currentIndex];
			const prevPanel = panels[currentIndex];
			if (prevTab) {
				prevTab.classList.remove("is-active", "is-timing", "is-paused");
				prevTab.setAttribute("aria-selected", "false");
				prevTab.setAttribute("tabindex", "-1");
			}
			if (prevPanel) {
				prevPanel.classList.remove("is-active");
				prevPanel.hidden = true;
				prevPanel.setAttribute("tabindex", "-1");
			}

			// Activate new
			currentIndex = newIndex;
			const nextTab = tabs[currentIndex];
			const nextPanel = panels[currentIndex];

			if (nextTab) {
				nextTab.classList.add("is-active");
				nextTab.setAttribute("aria-selected", "true");
				nextTab.setAttribute("tabindex", "0");
			}

			if (nextPanel) {
				nextPanel.hidden = false;
				void nextPanel.offsetWidth; // Trigger reflow for fade-in
				nextPanel.classList.add("is-active");
				nextPanel.setAttribute("tabindex", "0");
			}

			setTimeout(() => {
				isTransitioning = false;
				startTimer(TIMER_DURATION);
			}, TRANSITION_DURATION);
		}

		// Click handlers
		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => {
				switchTab(index, true);
			});
		});

		// Keyboard navigation (WAI-ARIA tabs)
		tabs.forEach((tab, index) => {
			tab.addEventListener("keydown", (e: KeyboardEvent) => {
				let targetIndex = -1;
				if (e.key === "ArrowDown" || e.key === "ArrowRight") {
					targetIndex = (index + 1) % tabs.length;
				} else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
					targetIndex = (index - 1 + tabs.length) % tabs.length;
				} else if (e.key === "Home") {
					targetIndex = 0;
				} else if (e.key === "End") {
					targetIndex = tabs.length - 1;
				}

				if (targetIndex !== -1) {
					e.preventDefault();
					tabs[targetIndex]?.focus();
					switchTab(targetIndex, true);
				}
			});
		});

		// Targeted pause only on tabs or panel content
		const onMouseEnter = () => {
			isHovered = true;
			pauseTimer();
		};

		const onMouseLeave = (e: MouseEvent) => {
			const related = e.relatedTarget as Node | null;
			const stillInside = interactiveTargets.some((el) => el.contains(related));
			if (stillInside) return;
			isHovered = false;
			resumeTimer();
		};

		const onFocusIn = () => {
			isHovered = true;
			pauseTimer();
		};

		const onFocusOut = (e: FocusEvent) => {
			const related = e.relatedTarget as Node | null;
			const stillInside = interactiveTargets.some((el) => el.contains(related));
			if (stillInside) return;
			isHovered = false;
			resumeTimer();
		};

		interactiveTargets.forEach((target) => {
			target.addEventListener("mouseenter", onMouseEnter);
			target.addEventListener("mouseleave", onMouseLeave);
			target.addEventListener("focusin", onFocusIn);
			target.addEventListener("focusout", onFocusOut);
		});

		// Visibility change (tab inactive)
		const onVisibilityChange = () => {
			if (document.hidden) {
				pauseTimer();
			} else if (isVisible && !isHovered) {
				resumeTimer();
			}
		};
		document.addEventListener("visibilitychange", onVisibilityChange);

		// Intersection Observer: run only when section is visible
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.target === section) {
						isVisible = entry.isIntersecting;
						if (isVisible) {
							if (!isStarted) {
								isStarted = true;
								startTimer(TIMER_DURATION);
							} else if (!isHovered) {
								resumeTimer();
							}
						} else {
							pauseTimer();
						}
					}
				}
			},
			{ threshold: 0.2 },
		);

		observer.observe(section);

		// Cleanup on Astro transitions / page navigation
		function cleanup() {
			clearTimer();
			observer.disconnect();
			interactiveTargets.forEach((target) => {
				target.removeEventListener("mouseenter", onMouseEnter);
				target.removeEventListener("mouseleave", onMouseLeave);
				target.removeEventListener("focusin", onFocusIn);
				target.removeEventListener("focusout", onFocusOut);
			});
			document.removeEventListener("visibilitychange", onVisibilityChange);
		}

		document.addEventListener("astro:before-swap", cleanup, { once: true });
	}

	setupShowcase();
	document.addEventListener("astro:page-load", setupShowcase);
</script>

<style>
	.showcase-section {
		position: relative;
		width: 100%;
		background-color: var(--background);
		border-top: 1px solid var(--border);
		padding: var(--space-24) var(--space-12);
		box-sizing: border-box;
	}

	.showcase-container {
		max-width: 1440px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.showcase-header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.showcase-title {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3.25rem);
		line-height: 1.1;
		color: var(--text);
		margin: 0;
		letter-spacing: -0.01em;
	}

	.showcase-lead {
		font-family: var(--font-body);
		font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
		color: var(--text-dim);
		max-width: 65ch;
		margin: 0;
		line-height: 1.4;
	}

	.showcase-grid {
		display: grid;
		grid-template-columns: minmax(300px, 360px) 1fr;
		gap: var(--space-10);
		align-items: start;
	}

	.showcase-nav-col {
		position: sticky;
		top: var(--space-8);
	}

	.showcase-panels-col {
		min-width: 0; /* prevent grid breakout */
	}

	.showcase-panels-wrapper {
		position: relative;
		min-height: 480px;
	}

	.showcase-panel {
		display: none;
		flex-direction: column;
		gap: var(--space-6);
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.showcase-panel.is-active {
		display: flex;
		opacity: 1;
		transform: translateY(0);
	}

	.panel-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--border-dim);
	}

	.panel-tag {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.08em;
	}

	.panel-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.375rem, 2.5vw, 2rem);
		color: var(--text);
		margin: 0;
		line-height: 1.2;
	}

	.panel-text {
		font-family: var(--font-body);
		font-size: 1.125rem;
		line-height: 1.5;
		color: var(--text-dim);
		margin: 0;
	}

	/* Manifesto Card (Tab 1) */
	.manifesto-card {
		background-color: var(--background-secondary);
		border: 1px solid var(--border);
		padding: var(--space-6);
		box-sizing: border-box;
		margin-top: var(--space-4);
	}

	.manifesto-header {
		padding-bottom: var(--space-4);
		border-bottom: 1px solid var(--border-dim);
		margin-bottom: var(--space-4);
	}

	.manifesto-badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.08em;
	}

	.manifesto-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.manifesto-list li {
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.4;
		color: var(--text-dim);
		position: relative;
		padding-left: var(--space-6);
	}

	.manifesto-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.45em;
		width: 6px;
		height: 6px;
		background-color: var(--accent);
	}

	.manifesto-highlight {
		color: var(--text);
		font-weight: 700;
	}

	/* Highlights Grid (Tab 3) */
	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.highlight-card {
		background-color: var(--background-secondary);
		border: 1px solid var(--border);
		padding: var(--space-5);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}

	.highlight-card:hover {
		border-color: var(--border-strong);
		background-color: var(--background-tertiary);
	}

	.highlight-badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.highlight-title {
		font-family: var(--font-heading);
		font-size: 1.0625rem;
		color: var(--text);
		margin: 0;
		line-height: 1.3;
	}

	.highlight-desc {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		line-height: 1.4;
		color: var(--text-dim);
		margin: 0;
	}

	@media (max-width: 1024px) {
		.showcase-grid {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}

		.showcase-nav-col {
			position: static;
		}

		.showcase-panels-wrapper {
			min-height: auto;
		}
	}

	@media (max-width: 768px) {
		.showcase-section {
			padding: var(--space-16) var(--space-6);
		}

		.highlights-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.showcase-section {
			padding: var(--space-12) var(--space-4);
		}

		.manifesto-card {
			padding: var(--space-4);
		}
	}
</style>
