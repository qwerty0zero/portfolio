---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getEntry } from "astro:content";
import LanguageSwitcher from "@components/ui/LanguageSwitcher.astro";
import ThemeButtons from "@components/ui/ThemeButtons.astro";
import { SITE } from "@/constants/site";
import { defaultLang, type Lang } from "@i18n/languages";
import { useTranslations } from "@i18n/utils";

export interface FooterProjectItem {
	title: string;
	slug: string;
	year: string;
	category?: string;
}

export interface Props {
	lang: Lang;
	projects?: FooterProjectItem[];
	class?: string;
	id?: string;
}

const {
	lang = defaultLang,
	projects = [],
	class: className = "",
	id = "footer",
} = Astro.props;

const footerEntry = await getEntry("home", `${lang}/footer`);
const bio = footerEntry?.data.bio || "";

const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const homeUrl = getRelativeLocaleUrl(lang, "");
const allProjectsUrl = getRelativeLocaleUrl(lang, "projects");

const navAnchors = (footerEntry?.data.navAnchors ?? []).map((item) => ({
	href: `${homeUrl}#${item.id}`,
	label: item.label,
}));

const topProjects = projects.slice(0, 3);
---

<footer id={id} class:list={["site-footer", className]}>
	<div class="footer-container">
		{/* Main 3 Columns Grid */}
		<div class="footer-columns">
			{/* Column 1: Personal Info & Socials / Email */}
			<div class="footer-col footer-col-author">
				<div class="author-branding">
					<span class="author-name">{SITE.author}</span>
					<span class="author-role">{SITE.role}</span>
				</div>
				<p class="author-bio">{bio}</p>

				<div class="contacts-block">
					<span class="col-subtitle">{t("footer.contactsTitle")}</span>
					<ul class="contacts-list">
						<li>
							<a
								href={SITE.github}
								target="_blank"
								rel="noopener noreferrer"
								class="contact-link"
							>
								<span class="link-label">GitHub</span>
								<span class="arrow-icon" aria-hidden="true"> ↗ </span>
							</a>
						</li>
						<li>
							<a
								href={SITE.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								class="contact-link"
							>
								<span class="link-label">LinkedIn</span>
								<span class="arrow-icon" aria-hidden="true"> ↗ </span>
							</a>
						</li>
						<li>
							<a href={`mailto:${SITE.email}`} class="contact-link">
								<span class="link-label">Email</span>
								<span class="contact-value">({SITE.email})</span>
							</a>
						</li>
					</ul>
				</div>
			</div>

			{/* Column 2: Anchor Navigation */}
			<nav
				class="footer-col footer-col-nav"
				aria-labelledby="footer-nav-heading"
			>
				<h2 id="footer-nav-heading" class="col-title">
					{t("footer.navTitle")}
				</h2>
				<ul class="nav-links-list">
					{navAnchors.map((anchor) => (
							<li>
								<a href={anchor.href} class="nav-anchor-link">
									<span class="bullet" aria-hidden="true">
										■
									</span>
									<span>{anchor.label}</span>
								</a>
							</li>
						))}
				</ul>
			</nav>

			{/* Column 3: Projects (All Projects + Top 3) */}
			<div class="footer-col footer-col-projects">
				<div class="projects-header-row">
					<h2 id="footer-projects-heading" class="col-title">
						{t("footer.projectsTitle")}
					</h2>
					<a href={allProjectsUrl} class="all-projects-link">
						<span>{t("projects.viewAll")}</span>
						<span class="arrow" aria-hidden="true">→</span>
					</a>
				</div>

				<ul class="projects-list">
					{topProjects.map((p) => (
							<li>
								<a
									href={getRelativeLocaleUrl(lang, `projects/${p.slug}`)}
									class="project-item-link"
								>
									<div class="project-info">
										<span class="project-name">{p.title}</span>
										{p.category && (
											<span class="project-category">{p.category}</span>
										)}
									</div>
									<span class="project-year">{p.year}</span>
								</a>
							</li>
						))}
				</ul>
			</div>
		</div>

		{/* Bottom Bar */}
		<div class="footer-bottom">
			<div class="bottom-left">
				<p class="copyright">
					© {currentYear}
					<span class="author-name-inline">{SITE.author}</span>.
					{t("footer.rights")}.
				</p>
			</div>

			<div class="bottom-center">
				<p class="produced-by">
					{t("footer.producedBy")}{" "}
					<a
						href={SITE.github}
						target="_blank"
						rel="noopener noreferrer"
						class="producer-link"
					>
						{SITE.nickname}
					</a>
				</p>
			</div>

			<div class="bottom-right">
				<ThemeButtons />

				<LanguageSwitcher />
			</div>
		</div>
	</div>
</footer>

<style>
.site-footer {
	position: relative;
	width: 100%;
	background-color: var(--background-secondary);
	border-top: 1px solid var(--border);
	z-index: 1;
}

.footer-container {
	width: 100%;
	max-width: 1400px;
	margin-inline: auto;
	padding: var(--space-12) var(--space-8) var(--space-8);
	display: flex;
	flex-direction: column;
	gap: var(--space-12);
}

/* Main Columns Grid */
.footer-columns {
	display: grid;
	grid-template-columns: 1.4fr 1fr 1.3fr;
	gap: var(--space-12);
	width: 100%;
}

.footer-col {
	display: flex;
	flex-direction: column;
	gap: var(--space-6);
}

/* Column 1: Author & Contacts */
.author-branding {
	display: flex;
	flex-direction: column;
	gap: var(--space-1);
}

.author-name {
	font-family: var(--font-heading);
	font-size: clamp(1.5rem, 2.2vw, 2.25rem);
	line-height: 1.1;
	color: var(--text);
	text-transform: uppercase;
	letter-spacing: -0.01em;
}

.author-role {
	font-family: var(--font-mono);
	font-size: 0.875rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--accent);
	font-weight: 700;
}

.author-bio {
	font-family: var(--font-body);
	font-size: 1.0625rem;
	line-height: 1.5;
	color: var(--text-dim);
	margin: 0;
	max-width: 480px;
}

.contacts-block {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
	padding-top: var(--space-4);
	border-top: 1px dashed var(--border-dim);
}

.col-subtitle {
	font-family: var(--font-mono);
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	color: var(--text-muted);
}

.contacts-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: var(--space-2);
}

.contact-link {
	display: inline-flex;
	align-items: baseline;
	gap: var(--space-2);
	font-family: var(--font-body);
	font-size: 1.0625rem;
	color: var(--text);
	transition: color var(--transition-fast);
	width: fit-content;
}

.contact-link:hover {
	color: var(--accent);
}

.arrow-icon {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	color: var(--accent);
	transition: transform var(--transition-fast);
}

.contact-link:hover .arrow-icon {
	transform: translate(2px, -2px);
}

.contact-value {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	color: var(--text-dim);
}

/* Titles */
.col-title {
	font-family: var(--font-heading);
	font-size: 1.125rem;
	line-height: 1.2;
	color: var(--text);
	text-transform: uppercase;
	letter-spacing: -0.01em;
	margin: 0;
}

/* Column 2: Navigation Links */
.nav-links-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}

.nav-anchor-link {
	display: inline-flex;
	align-items: center;
	gap: var(--space-3);
	font-family: var(--font-body);
	font-size: 1.0625rem;
	color: var(--text-dim);
	transition:
		color var(--transition-fast),
		transform var(--transition-fast);
	width: fit-content;
}

.nav-anchor-link .bullet {
	color: var(--border-strong);
	font-size: 0.5rem;
	transition: color var(--transition-fast);
}

.nav-anchor-link:hover {
	color: var(--text);
	transform: translateX(4px);
}

.nav-anchor-link:hover .bullet {
	color: var(--accent);
}

/* Column 3: Projects */
.projects-header-row {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: var(--space-4);
	flex-wrap: wrap;
}

.all-projects-link {
	display: inline-flex;
	align-items: center;
	gap: var(--space-2);
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--accent);
	font-weight: 700;
	transition: color var(--transition-fast);
}

.all-projects-link:hover {
	color: var(--accent-hover);
}

.all-projects-link .arrow {
	transition: transform var(--transition-fast);
}

.all-projects-link:hover .arrow {
	transform: translateX(3px);
}

.projects-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
}

.project-item-link {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--space-3) var(--space-4);
	background-color: var(--background-tertiary);
	border: 1px solid var(--border);
	transition:
		border-color var(--transition-fast),
		background-color var(--transition-fast);
}

.project-item-link:hover {
	border-color: var(--accent);
	background-color: var(--background-elevated);
}

.project-info {
	display: flex;
	flex-direction: column;
	gap: 2px;
}

.project-name {
	font-family: var(--font-body);
	font-size: 1rem;
	font-weight: 700;
	color: var(--text);
}

.project-category {
	font-family: var(--font-mono);
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	color: var(--text-muted);
}

.project-year {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	color: var(--accent);
	font-weight: 700;
}

/* Bottom Bar */
.footer-bottom {
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: var(--space-6);
	padding-top: var(--space-8);
	border-top: 1px solid var(--border);
}

.bottom-right {
	display: flex;
	align-items: end;

	gap: 1.5rem;
}

.copyright {
	font-family: var(--font-body);
	font-size: 0.9375rem;
	color: var(--text-dim);
	margin: 0;
}

.author-name-inline {
	text-transform: uppercase;
	font-weight: 700;
	color: var(--text);
}

.produced-by {
	font-family: var(--font-mono);
	font-size: 0.8125rem;
	color: var(--text-muted);
	margin: 0;
}

.producer-link {
	color: var(--text);
	font-weight: 700;
	text-decoration: underline;
	text-underline-offset: 3px;
	transition: color var(--transition-fast);
}

.producer-link:hover {
	color: var(--accent);
}

/* Tablet Layout (769px - 1024px) */
@media (max-width: 1024px) {
	.footer-columns {
		grid-template-columns: 1fr 1fr;
		gap: var(--space-8);
	}

	.footer-col-author {
		grid-column: 1 / -1;
	}
}

/* Mobile Layout (<= 768px) */
@media (max-width: 768px) {
	.footer-container {
		padding: var(--space-8) var(--space-4) var(--space-6);
		gap: var(--space-8);
	}

	.footer-columns {
		grid-template-columns: 1fr;
		gap: var(--space-8);
	}

	/* Touch targets >= 44px for accessibility */
	.contact-link,
	.nav-anchor-link,
	.all-projects-link {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
	}

	.project-item-link {
		min-height: 48px;
	}

	.footer-bottom {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.bottom-right {
		width: 100%;
	}

	.nav-links-list,
	.contacts-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.contact-value {
		display: none;
	}
}

@media (prefers-reduced-motion: reduce) {
	.nav-anchor-link:hover,
	.all-projects-link:hover .arrow {
		transform: none;
	}
}
</style>
