---
import DitherBackground from "../ui/DitherBackground.astro";

export interface Props {
	name?: string;
	role?: string;
	scrollCueText?: string;
	id?: string;
	class?: string;
}

const {
	name = "ihor kuhel",
	role = "Software Developer",
	id = "hero",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["hero", className]}
	aria-labelledby="hero-heading"
>
	<DitherBackground
		id="hero-dither-bg"
		waveSpeed={0.04}
		waveFrequency={2.8}
		waveAmplitude={0.32}
		waveColor="var(--accent-muted)"
		backgroundColor="var(--background)"
		colorNum={4.0}
		pixelSize={2.0}
		enableMouseInteraction={true}
		mouseRadius={0.3}
	/>

	<div class="hero-content">
		<h1 id="hero-heading" class="hero-title">
			<span class="hero-name">{name}</span>
			<span class="hero-role">{role}</span>
		</h1>
	</div>
</section>

<style>
	.hero {
		position: relative;
		width: 100%;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-8) var(--space-6);
		overflow: hidden;
		background-color: var(--background);
		box-sizing: border-box;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1200px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: auto;
		user-select: text;
	}

	.hero-title {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
	}

	.hero-name {
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 7.5vw, 6.5rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		font-weight: 400;
		color: var(--text);
		text-transform: uppercase;
		word-break: break-word;
	}

	.hero-role {
		font-family: var(--font-body);
		font-size: clamp(1.125rem, 2.2vw, 1.875rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	@media (max-width: 768px) {
		.hero {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
