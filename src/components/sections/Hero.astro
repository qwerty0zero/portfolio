---
import DitherBackground from "../ui/DitherBackground.astro";
import IconGithub from "../ui/icons/IconGithub.astro";
import IconLinkedin from "../ui/icons/IconLinkedin.astro";

export interface Props {
	name?: string;
	role?: string;
	githubUrl?: string;
	linkedinUrl?: string;
	scrollCueText?: string;
	id?: string;
	class?: string;
}

const {
	name = "ihor kuhel",
	role = "Software Developer",
	githubUrl = "https://github.com/qwerty0zero",
	linkedinUrl = "https://www.linkedin.com/in/ihor-kuhel-993399167/",
	id = "hero",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["hero", className]}
	aria-labelledby="hero-heading"
>
	<DitherBackground
		id="hero-dither-bg"
		waveSpeed={0.04}
		waveFrequency={2.8}
		waveAmplitude={0.32}
		waveColor="var(--accent-muted)"
		backgroundColor="var(--background)"
		colorNum={4.0}
		pixelSize={2.0}
		enableMouseInteraction={true}
		mouseRadius={0.3}
	/>

	<div class="hero-content">
		<h1 id="hero-heading" class="hero-title">
			<span class="hero-name">{name}</span>
			<span class="hero-role">{role}</span>
		</h1>
		<nav class="hero-socials" aria-label="Social links">
			<a
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="GitHub"
				title="GitHub"
			>
				<IconGithub size={24} class="hero-social-icon" />
			</a>
			<a
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="LinkedIn"
				title="LinkedIn"
			>
				<IconLinkedin size={24} class="hero-social-icon" />
			</a>
		</nav>
	</div>
</section>

<style>
	.hero {
		position: sticky;
		top: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: var(--space-24) var(--space-12);
		overflow: hidden;
		background-color: var(--background);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		width: 100%;
		display: flex;
		align-items: flex-end;
		flex-direction: row;
		justify-content: space-between;
		text-align: left;
		pointer-events: auto;
		user-select: text;
	}

	.hero-title {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.hero-name {
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 7.5vw, 6.5rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		font-weight: 400;
		color: var(--text);
		text-transform: uppercase;
		word-break: break-word;
	}

	.hero-role {
		font-family: var(--font-body);
		font-size: clamp(1.125rem, 2.2vw, 1.875rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hero-socials {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hero-social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--text);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.hero-social-icon {
		width: 24px;
		height: 24px;
		fill: currentColor;
		flex-shrink: 0;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-social-link:hover {
			color: var(--accent);
			transform: translateY(-2px);
		}
	}

	.hero-social-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (max-width: 768px) {
		.hero {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
