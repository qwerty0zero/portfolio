---
import DitherBackground from "@components/ui/DitherBackground.astro";
import IconGithub from "@components/ui/icons/IconGithub.astro";
import IconLinkedin from "@components/ui/icons/IconLinkedin.astro";
import { SITE } from "@/constants/site";

export interface Props {
	id?: string;
	class?: string;
}

const { id = "hero", class: className = "" } = Astro.props;
---

<div id={id} class="hero-scroll-anchor" aria-hidden="true"></div>
<div
	id={`${id}-tracker`}
	class="hero-tracker fullscreen"
	aria-hidden="true"
></div>
<section
	id={`${id}-section`}
	class:list={["hero", "fullscreen", className]}
	aria-labelledby="hero-heading"
>
	<DitherBackground
		id="hero-dither-bg"
		observerTarget={`#${id}-tracker`}
		waveSpeed={0.04}
		waveFrequency={2.8}
		waveAmplitude={0.32}
		waveColor="var(--accent-muted)"
		backgroundColor="var(--background)"
		colorNum={4.0}
		pixelSize={2.0}
		enableMouseInteraction={true}
		mouseRadius={0.3}
	/>

	<div class="hero-content">
		<h1 id="hero-heading" class="hero-title">
			<span class="hero-name heading-display">{SITE.author}</span>
			<span class="hero-role text-lead-accent">{SITE.role}</span>
		</h1>
		<nav class="hero-socials" aria-label="Social links">
			<a
				href={SITE.github}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="GitHub"
				title="GitHub"
			>
				<IconGithub size={24} class="hero-social-icon" />
			</a>
			<a
				href={SITE.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="LinkedIn"
				title="LinkedIn"
			>
				<IconLinkedin size={24} class="hero-social-icon" />
			</a>
		</nav>
	</div>
</section>

<style>
.hero-scroll-anchor {
	position: absolute;
	top: 0;
	left: 0;
	width: 1px;
	height: 1px;
	pointer-events: none;
	visibility: hidden;
}

.hero-tracker {
	position: absolute;
	top: 0;
	left: 0;
	width: 1px;
	pointer-events: none;
	visibility: hidden;
	z-index: -1;
}

.hero {
	position: sticky;
	top: 0;
	z-index: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-end;
	overflow: hidden;
}

.hero-content {
	position: relative;
	z-index: 1;
	width: 100%;
	display: flex;
	align-items: flex-end;
	flex-direction: row;
	justify-content: space-between;
	text-align: left;
	pointer-events: auto;
	user-select: text;
}

.hero-title {
	margin: 0;
	padding: 0;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: var(--space-4);
}

.hero-name {
	word-break: break-word;
}

.hero-role {
	font-size: var(--font-size-h4);
	letter-spacing: var(--letter-spacing-widest);
}

.hero-socials {
	display: flex;
	align-items: center;
	gap: var(--space-2);
}

.hero-social-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 44px;
	height: 44px;
	color: var(--text);
	text-decoration: none;
	transition:
		color var(--transition-fast),
		transform var(--transition-fast);
}

.hero-social-icon {
	width: 24px;
	height: 24px;
	fill: currentColor;
	flex-shrink: 0;
}

@media (hover: hover) and (pointer: fine) {
	.hero-social-link:hover {
		color: var(--accent);
		transform: translateY(-2px);
	}
}

.hero-social-link:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: 2px;
}

@media (max-width: 768px) {
	.hero {
		padding: var(--space-6) var(--space-4);
	}
}
</style>
