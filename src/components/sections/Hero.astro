---
import DitherBackground from "../ui/DitherBackground.astro";

export interface Props {
	name?: string;
	role?: string;
	githubUrl?: string;
	linkedinUrl?: string;
	scrollCueText?: string;
	id?: string;
	class?: string;
}

const {
	name = "ihor kuhel",
	role = "Software Developer",
	githubUrl = "https://github.com/qwerty0zero",
	linkedinUrl = "https://www.linkedin.com/in/ihor-kuhel-993399167/",
	id = "hero",
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["hero", className]}
	aria-labelledby="hero-heading"
>
	<DitherBackground
		id="hero-dither-bg"
		waveSpeed={0.04}
		waveFrequency={2.8}
		waveAmplitude={0.32}
		waveColor="var(--accent-muted)"
		backgroundColor="var(--background)"
		colorNum={4.0}
		pixelSize={2.0}
		enableMouseInteraction={true}
		mouseRadius={0.3}
	/>

	<div class="hero-content">
		<h1 id="hero-heading" class="hero-title">
			<span class="hero-name">{name}</span>
			<span class="hero-role">{role}</span>
		</h1>
		<nav class="hero-socials" aria-label="Social links">
			<a
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="GitHub"
				title="GitHub"
			>
				<svg
					class="hero-social-icon"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
					></path>
				</svg>
			</a>
			<a
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hero-social-link"
				aria-label="LinkedIn"
				title="LinkedIn"
			>
				<svg
					class="hero-social-icon"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 1 0 0 3.3 1.65 1.65 0 0 0 0-3.3z"></path>
				</svg>
			</a>
		</nav>
	</div>
</section>

<style>
	.hero {
		position: sticky;
		top: 0;
		z-index: 0;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: var(--space-24) var(--space-12);
		overflow: hidden;
		background-color: var(--background);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		width: 100%;
		display: flex;
		align-items: flex-end;
		flex-direction: row;
		justify-content: space-between;
		text-align: left;
		pointer-events: auto;
		user-select: text;
	}

	.hero-title {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.hero-name {
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 7.5vw, 6.5rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
		font-weight: 400;
		color: var(--text);
		text-transform: uppercase;
		word-break: break-word;
	}

	.hero-role {
		font-family: var(--font-body);
		font-size: clamp(1.125rem, 2.2vw, 1.875rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hero-socials {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hero-social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--text);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.hero-social-icon {
		width: 24px;
		height: 24px;
		fill: currentColor;
		flex-shrink: 0;
	}

	@media (hover: hover) and (pointer: fine) {
		.hero-social-link:hover {
			color: var(--accent);
			transform: translateY(-2px);
		}
	}

	.hero-social-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (max-width: 768px) {
		.hero {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
