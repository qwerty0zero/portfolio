---
import type { FaqItem } from "@/content.config";
import Badge from "@components/ui/Badge.astro";

export interface Props {
	id?: string;
	badge?: string;
	title: string;
	lead?: string;
	items: FaqItem[];
	class?: string;
}

const {
	id = "faq",
	badge,
	title,
	lead,
	items = [],
	class: className = "",
} = Astro.props;
---

<section
	id={id}
	class:list={["faq-section", className]}
	aria-labelledby="faq-heading"
>
	<div class="faq-container">
		<header class="faq-header">
			<div class="faq-header-top">
				<Badge text={badge} />
				<h2 id="faq-heading" class="faq-title heading-2">{title}</h2>
			</div>
			{lead && <p class="faq-lead text-lead">{lead}</p>}
		</header>

		<div class="faq-list">
			{items.map((item) => (
					<details class="faq-item" id={`faq-item-${item.id}`}>
						<summary class="faq-summary">
							<span class="faq-summary-content">
								<span class="faq-index text-eyebrow">{item.index}</span>
								<span class="faq-question-wrap">
									{item.category && (
										<span class="faq-category text-mono-label">{item.category}</span>
									)}
									<span class="faq-question heading-4">{item.question}</span>
								</span>
							</span>
							<span class="faq-icon">
								+
							</span>
						</summary>

						<div class="faq-answer-wrapper">
							<div class="faq-answer-inner">
								<p class="faq-answer-text text-body-lg">{item.answer}</p>
							</div>
						</div>
					</details>
				))}
		</div>
	</div>
</section>

<script>
class FaqAccordion {
	private details: HTMLDetailsElement;
	private summary: HTMLElement | null;
	private content: HTMLElement | null;
	private animation: Animation | null = null;
	private isClosing = false;
	private isExpanding = false;
	private onSummaryClickBound: (e: MouseEvent) => void;

	constructor(el: HTMLDetailsElement) {
		this.details = el;
		this.summary = el.querySelector(".faq-summary");
		this.content = el.querySelector(".faq-answer-wrapper");
		this.onSummaryClickBound = (e: MouseEvent) => this.onClick(e);

		if (this.summary && this.content) {
			this.summary.addEventListener("click", this.onSummaryClickBound);
		}
	}

	private isReducedMotion(): boolean {
		return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	}

	private onClick(e: MouseEvent) {
		e.preventDefault();
		if (!this.content) return;

		if (this.isReducedMotion()) {
			this.details.open = !this.details.open;
			return;
		}

		if (this.isClosing || !this.details.open) {
			this.open();
		} else if (this.isExpanding || this.details.open) {
			this.shrink();
		}
	}

	private shrink() {
		if (!this.content) return;
		this.isClosing = true;
		const startHeight = `${this.content.offsetHeight}px`;

		if (this.animation) {
			this.animation.cancel();
		}

		this.animation = this.content.animate(
			{
				height: [startHeight, "0px"],
				opacity: [1, 0],
			},
			{
				duration: 260,
				easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			},
		);

		this.animation.onfinish = () => {
			this.details.open = false;
			this.animation = null;
			this.isClosing = false;
			if (this.content) {
				this.content.style.height = "";
			}
		};
		this.animation.oncancel = () => {
			this.isClosing = false;
		};
	}

	private open() {
		if (!this.content) return;
		this.details.open = true;
		this.isExpanding = true;

		// Natural content height
		const targetHeight = `${this.content.scrollHeight}px`;

		if (this.animation) {
			this.animation.cancel();
		}

		this.animation = this.content.animate(
			{
				height: ["0px", targetHeight],
				opacity: [0, 1],
			},
			{
				duration: 260,
				easing: "cubic-bezier(0.16, 1, 0.3, 1)",
			},
		);

		this.animation.onfinish = () => {
			this.animation = null;
			this.isExpanding = false;
			if (this.content) {
				this.content.style.height = "";
			}
		};
		this.animation.oncancel = () => {
			this.isExpanding = false;
		};
	}

	public destroy() {
		if (this.summary) {
			this.summary.removeEventListener("click", this.onSummaryClickBound);
		}
		if (this.animation) {
			this.animation.cancel();
		}
		if (this.content) {
			this.content.style.height = "";
		}
	}
}

function setupFaq() {
	const items = document.querySelectorAll<HTMLDetailsElement>(".faq-item");
	const instances: FaqAccordion[] = [];
	items.forEach((item) => {
		instances.push(new FaqAccordion(item));
	});

	document.addEventListener(
		"astro:before-swap",
		() => {
			instances.forEach((inst) => {
				inst.destroy();
			});
		},
		{ once: true },
	);
}

setupFaq();
document.addEventListener("astro:page-load", setupFaq);
</script>

<style>
.faq-container {
	width: 100%;
	max-width: 1440px;
	margin-inline: auto;
	display: flex;
	flex-direction: column;
	gap: var(--space-12);
}

.faq-header {
	display: flex;
	flex-direction: column;
	gap: var(--space-4);
	max-width: 800px;
}

.faq-header-top {
	display: flex;
	flex-direction: column;
	gap: var(--space-3);
	align-items: flex-start;
}
.faq-title {
	margin: 0;
}

.faq-lead {
	margin: 0;
}

/* 1 question per row list: no card background, border-bottom divider */
.faq-list {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.faq-item {
	display: block;
	width: 100%;
	background-color: transparent;
	border-bottom: 1px solid var(--border);
	transition: border-color var(--transition-base);
}

.faq-item[open] {
	border-bottom-color: var(--border-strong);
}

/* Summary element: full row */
.faq-summary {
	position: relative;
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--space-6);
	padding: var(--space-6);
	background-color: transparent;
	color: var(--text);
	cursor: pointer;
	user-select: none;
	outline: none;
	transition: color var(--transition-base);
}

.faq-summary::-webkit-details-marker {
	display: none;
}

.faq-summary::marker {
	display: none;
}

/* Animated ::after pseudo-element sliding from bottom to top with accent background */
.faq-summary::after {
	content: "";
	position: absolute;
	inset: 0;
	background-color: var(--accent);
	transform: translateY(100%) translateZ(0);
	will-change: transform;
	backface-visibility: hidden;
	transition: transform var(--duration-smooth) var(--ease-out-expo);
	z-index: 0;
}

.faq-summary:hover::after,
.faq-summary:focus-visible::after {
	transform: translateY(0) translateZ(0);
}

.faq-summary:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -2px;
}

.faq-summary-content {
	position: relative;
	z-index: 1;
	display: flex;
	align-items: center;
	gap: var(--space-8);
	flex: 1;
	min-width: 0;
}

.faq-index {
	display: inline-block;
	width: 32px;
	flex-shrink: 0;
	transition: color var(--transition-base);
}

.faq-question-wrap {
	display: flex;
	flex-direction: column;
	gap: var(--space-1);
	min-width: 0;
}

.faq-category {
	transition: color var(--transition-base);
}

.faq-question {
	margin: 0;
	transition: color var(--transition-base);
}

.faq-icon {
	position: relative;
	z-index: 1;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 32px;
	height: 32px;
	font-family: var(--font-mono);
	font-size: var(--font-size-2xl);
	font-weight: var(--font-weight-bold);
	color: var(--accent);
	line-height: 1;
	flex-shrink: 0;
	transition:
		transform var(--transition-smooth),
		color var(--transition-base);
}

/* Color inversion on hover */
.faq-summary:hover .faq-index,
.faq-summary:focus-visible .faq-index,
.faq-summary:hover .faq-category,
.faq-summary:focus-visible .faq-category,
.faq-summary:hover .faq-question,
.faq-summary:focus-visible .faq-question,
.faq-summary:hover .faq-icon,
.faq-summary:focus-visible .faq-icon {
	color: var(--accent-foreground);
}

/* When [open] */
.faq-item[open] .faq-icon {
	transform: rotate(45deg);
}

/* Answer content box: smoothly expanded via height and opacity on wrapper */
.faq-answer-wrapper {
	overflow: hidden;
	background-color: transparent;
}

.faq-answer-inner {
	display: flex;
	flex-direction: column;
	padding: var(--space-2) var(--space-6) var(--space-8);
	padding-left: calc(var(--space-6) + 32px + var(--space-8));
}

.faq-answer-text {
	margin: 0;
}

/* Breakpoints */
@media (max-width: 860px) {
	.faq-summary {
		gap: var(--space-4);
		padding: var(--space-6) var(--space-4);
	}

	.faq-summary-content {
		gap: var(--space-5);
	}

	.faq-answer-inner {
		padding: var(--space-2) var(--space-4) var(--space-6);
		padding-left: calc(var(--space-4) + 32px + var(--space-5));
	}
}

@media (max-width: 580px) {
	.faq-section {
		padding: var(--space-16) var(--space-6);
	}

	.faq-summary {
		gap: var(--space-3);
		padding: var(--space-5) var(--space-3);
	}

	.faq-summary-content {
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.faq-index {
		font-size: var(--font-size-sm);
	}

	.faq-question {
		font-size: var(--font-size-base);
	}

	.faq-answer-inner {
		padding: var(--space-2) var(--space-3) var(--space-6);
		padding-left: var(--space-3);
	}

	.faq-answer-text {
		font-size: var(--font-size-sm);
	}
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
	.faq-summary::after,
	.faq-icon,
	.faq-answer-wrapper {
		animation: none;
		transition: none;
	}
}
</style>
